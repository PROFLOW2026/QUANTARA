# =============================================================================
# QUANTARA — environment template (safe to commit, NO secrets)
# Copy to repo root `.env` and fill in values marked REQUIRED.
# Project: QUANTARA Supabase only — NOT ProjectFlow.
# =============================================================================

# --- PostgreSQL / Supabase (REQUIRED for runtime) ---------------------------
# Supabase → Project Settings → Database → Connection string → URI (Pooler, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: direct connection for psql / one-off admin (port 5432, bypasses pooler)
# Supabase → Project Settings → Database → Connection string → URI (Direct)
# DIRECT_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres

# Label only — documents which Supabase project this repo uses
SUPABASE_PROJECT=QUANTARA

# --- Python Engine / FastAPI --------------------------------------------------
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000

# API key checked on all /api/v1/* routes (header: X-API-Key)
QUANTARA_API_KEY=dev-api-key

# Comma-separated browser origins allowed by FastAPI CORS
CORS_ORIGINS=http://localhost:3000,https://quantara-psi.vercel.app

# Stable Cloudflare Tunnel Engine URL (optional — see npm run setup:tunnel)
# STABLE_ENGINE_URL=https://engine.yourdomain.com
# CLOUDFLARE_TUNNEL_NAME=quantara-engine
# CLOUDFLARE_TUNNEL_CONFIG=scripts/cloudflare-tunnel.local.yml

# --- Next.js Web --------------------------------------------------------------
# Server-side Engine URL for /api/engine/* proxy (REQUIRED on Vercel production)
ENGINE_URL=http://localhost:8000

# Legacy browser-visible URL (local dev only; production browser uses /api/engine proxy)
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# Must match QUANTARA_API_KEY (sent as X-API-Key from the web app)
NEXT_PUBLIC_API_KEY=dev-api-key

# --- Workers / Market data ----------------------------------------------------
# mock = deterministic local candles (dev/tests)
# twelvedata = Twelve Data REST (requires Basic+ API key)
MARKET_DATA_PROVIDER=mock
# Twelve Data → Dashboard → API Keys (never commit real keys)
MARKET_DATA_API_KEY=

# Tiingo → Account → API (US equities + crypto intraday, free tier ~50 req/hour)
TIINGO_API_KEY=

# Alpaca → Paper account → API Keys (US equities IEX + crypto, free tier)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# Worker singleton lock file (.quantara-workers.lock) prevents duplicate schedulers.
# Live provider audit scripts require QUANTARA_LIVE_PROVIDER_AUDIT=1 or --live.

# --- App defaults (seed script + engine settings) -----------------------------
DEFAULT_TIMEZONE=Asia/Jerusalem
DEFAULT_INITIAL_CAPITAL=10000

# Paper trading defaults (engine reads via pydantic-settings)
PAPER_TRADING_ENABLED=true
PAPER_DEFAULT_SPREAD=0.30
PAPER_DEFAULT_SLIPPAGE_PCT=0.0001
PAPER_DEFAULT_FEE_RATE=0.0
PAPER_FILL_TIMING=next_open
