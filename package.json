{
  "name": "quantara",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:all": "node scripts/dev-all.mjs",
    "dev:remote": "node scripts/dev-remote.mjs",
    "start:quantara": "node scripts/start-quantara.mjs",
    "stop:quantara": "node scripts/stop-quantara.mjs",
    "dev:web": "npm run dev --workspace=@quantara/web",
    "build:web": "npm run build --workspace=@quantara/web",
    "start:web": "npm run start --workspace=@quantara/web",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "python scripts/seed.py",
    "db:seed:competition": "python scripts/seed_competition.py",
    "db:seed:orb": "python scripts/seed_orb_strategy.py && python scripts/seed_orb_competition.py",
    "db:seed:orb:activate": "python scripts/seed_orb_strategy.py && python scripts/seed_orb_competition.py --activate",
    "db:seed:multi": "python scripts/seed_multi_strategies.py && python scripts/seed_multi_strategy_competition.py --activate",
    "demo": "python scripts/demo.py",
    "verify:db": "python scripts/verify_local_runtime.py",
    "verify:db:legacy": "python scripts/verify_supabase_runtime.py",
    "db:bootstrap": "python scripts/bootstrap_market_data.py",
    "db:purge-mock": "python scripts/purge_mock_candles.py",
    "report:market-data": "python scripts/report_market_data_coverage.py",
    "db:provision:local": "powershell -ExecutionPolicy Bypass -File scripts/provision_local_prod_db.ps1",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup_local_db.ps1",
    "preflight:local": "node scripts/preflight-local-runtime.mjs",
    "verify:twelvedata": "python scripts/verify_twelvedata.py",
    "test:engine": "cd apps/engine && python -m pytest tests/ -q",
    "test:web:profit-target": "node --test apps/web/lib/profit-target.test.mjs",
    "test:launcher": "node --test scripts/test-quantara-launcher.mjs"
  },
  "devDependencies": {
    "pg": "^8.23.0"
  }
}
